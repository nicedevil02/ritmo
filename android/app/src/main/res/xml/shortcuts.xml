<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_new_task"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_task"
        android:shortcutLongLabel="@string/shortcut_new_task_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ir.ritmo.app"
            android:targetClass="ir.ritmo.app.MainActivity">
            <extra android:name="open_screen" android:value="tasks" />
            <extra android:name="focus_add" android:value="true" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_my_day"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_my_day"
        android:shortcutLongLabel="@string/shortcut_my_day_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="ir.ritmo.app"
            android:targetClass="ir.ritmo.app.MainActivity">
            <extra android:name="open_screen" android:value="my_day" />
        </intent>
    </shortcut>
</shortcuts>
