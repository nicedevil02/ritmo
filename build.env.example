# ======================================================
# ریتمو — متغیرهای محیطی build (نمونه)
# ======================================================
# این فایل را کپی کرده، نام آن را build.env بگذارید
# و مقادیر واقعی را جایگزین placeholder ها کنید.
# هرگز فایل build.env واقعی را commit نکنید!
# ======================================================

# ─── فلیور ────────────────────────────────────────────
# مقادیر مجاز: bazaar | myket | direct
FLAVOR=bazaar

# ─── کافه‌بازار ───────────────────────────────────────
# کلید RSA عمومی از پنل اپ کافه‌بازار
BAZAAR_RSA_KEY=YOUR_BAZAAR_RSA_PUBLIC_KEY_HERE

# ─── مایکت ────────────────────────────────────────────
# کلید RSA عمومی از پنل مایکت
MYKET_RSA_KEY=YOUR_MYKET_RSA_PUBLIC_KEY_HERE

# ─── تپسل ─────────────────────────────────────────────
# APP ID از پنل تپسل‌پلاس
TAPSELL_APP_ID=YOUR_TAPSELL_APP_ID_HERE

# Zone ID بنر (۳۲۰×۵۰)
TAPSELL_BANNER_ZONE_ID=YOUR_BANNER_ZONE_ID_HERE

# Zone ID جایزه‌ای (Rewarded Video)
TAPSELL_REWARDED_ZONE_ID=YOUR_REWARDED_ZONE_ID_HERE

# ─── نحوه استفاده در build ────────────────────────────
# flutter build apk \
#   --release \
#   --flavor bazaar \
#   --dart-define=FLAVOR=bazaar \
#   --dart-define=BAZAAR_RSA_KEY=... \
#   --dart-define=TAPSELL_APP_ID=... \
#   --dart-define=TAPSELL_BANNER_ZONE_ID=... \
#   --dart-define=TAPSELL_REWARDED_ZONE_ID=...
