<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/notif_bg">

    <!-- 1. Header Row (RTL) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left: Progress Stats -->
        <TextView
            android:id="@+id/txt_expanded_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="کارهای امروز: ۳ از ۵ (۶۰٪)"
            android:textColor="@color/notif_text_secondary"
            android:textSize="11sp" />

        <!-- Right: App Title / Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ریتمو در جریان است 🌿"
                android:textColor="@color/notif_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Ritmo" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Daily Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar_today"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:progress="60"
        android:max="100"
        android:progressBackgroundTint="@color/notif_progress_bg"
        android:progressTint="@color/notif_progress_fill" />

    <!-- 3. Next Action Card Container -->
    <LinearLayout
        android:id="@+id/card_next_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:background="@drawable/bg_notification_card">

        <!-- Task Headline -->
        <TextView
            android:id="@+id/txt_expanded_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اقدام بعدی: مطالعه کتاب و خلاصه‌نویسی"
            android:textColor="@color/notif_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Task Subtitle / Details -->
        <TextView
            android:id="@+id/txt_expanded_task_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ساعت پیشنهادی: ۱۶:۳۰ • مدت تخمینی: ۲۰ دقیقه"
            android:textColor="@color/notif_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 4. Quick Action Buttons Hub (RTL Row: Done | Timer | Snooze) -->
    <LinearLayout
        android:id="@+id/layout_action_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center">

        <!-- 1. Snooze Action (Left) -->
        <TextView
            android:id="@+id/btn_expanded_snooze"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⏰ نیم‌ساعت بعد"
            android:textColor="@color/notif_action_secondary_text"
            android:textSize="10.5sp"
            android:gravity="center"
            android:background="@drawable/bg_notification_button_inactive"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 2. Start Timer Action (Center) -->
        <TextView
            android:id="@+id/btn_expanded_timer"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="▶ شروع تایمر"
            android:textColor="@color/notif_action_secondary_text"
            android:textSize="10.5sp"
            android:gravity="center"
            android:background="@drawable/bg_notification_button_inactive"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 3. Done Action (Right) -->
        <TextView
            android:id="@+id/btn_expanded_done"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="✓ انجام شد"
            android:textColor="@color/notif_action_primary_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_notification_button_active"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>