# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.js text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.db binary
*.sqlite binary
*.dll binary
*.so binary
*.dylib binary
